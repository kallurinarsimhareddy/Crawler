# <DataDir>\config\sanagtm.env - written by Install-SanaGtm.ps1, readable only by SYSTEM,
# Administrators, the installing user and (service mode) LocalService. Placeholders only here.
CAREERCLOUD_ENV=production
CAREERCLOUD_SELF_HOSTED=1
CAREERCLOUD_STORAGE=postgres
CAREERCLOUD_QUEUE=postgres
CAREERCLOUD_DATABASE_URL=postgresql://sanagtm:<generated>@127.0.0.1:55432/sanagtm
CAREERCLOUD_DB_USER_ROLE=authenticated
CAREERCLOUD_DB_POOL_MAX=8
CAREERCLOUD_AUTH_MODE=supabase
CAREERCLOUD_SUPABASE_URL=https://<project-ref>.supabase.co
CAREERCLOUD_API_ORIGIN=https://sanagtm.example.com
CAREERCLOUD_CORS_ORIGINS=https://sanagtm.example.com
CAREERCLOUD_TRUST_PROXY=cloudflare
CAREERCLOUD_LOG_FORMAT=json
CAREERCLOUD_LOG_LEVEL=INFO
CAREERCLOUD_STORAGE_BACKEND=local
CAREERCLOUD_RUNNER=none
CAREERCLOUD_PLATFORM_SECRETS_KEY=<44-character Fernet key - the EXISTING one when migrating>
CAREERCLOUD_PLATFORM_FILES_DIR=D:\SanaGtmData\files
CAREERCLOUD_RESULTS_DIR=D:\SanaGtmData\results
CAREERCLOUD_WORKER_STATE_FILE=D:\SanaGtmData\run\worker-state.json
CAREERCLOUD_RESOURCE_REGISTRY=D:\SanaGtmData\run\resources.json
SANAGTM_PUBLIC_SUPABASE_URL=https://<project-ref>.supabase.co
SANAGTM_PUBLIC_SUPABASE_ANON_KEY=<public anon key>
SANAGTM_WEB_DIST=C:\Program Files\SANA GTM\web\dist
SANAGTM_API_PORT=8100
SANAGTM_LEGACY_DATABASE_HOSTS=aws-0-<region>.pooler.supabase.com
TMP=D:\SanaGtmData\files\tmp
TEMP=D:\SanaGtmData\files\tmp
TMPDIR=D:\SanaGtmData\files\tmp
# Optional integrations (then: sanagtm restart):
# GEMINI_API_KEY= / ANTHROPIC_API_KEY= / ZOOMINFO_CLIENT_ID= / ZOOMINFO_CLIENT_SECRET=
# CAREERCLOUD_SMTP_HOST= / CAREERCLOUD_SMTP_PORT= / CAREERCLOUD_SMTP_USER= / CAREERCLOUD_SMTP_PASSWORD= / CAREERCLOUD_SMTP_FROM=
