# Unattended install answers: Install-SanaGtm.ps1 -AnswersFile <copy of this file>.
# Keep the real copy OUTSIDE the package, in a folder only you can read, and delete it after
# installing. Secrets are best given as *_FILE paths to files that hold only the value.
HOSTNAME=sanagtm.example.com
SUPABASE_URL=https://<project-ref>.supabase.co
SUPABASE_ANON_KEY=<public anon / publishable key>
# The EXISTING key from the current install, so stored provider credentials stay readable:
PLATFORM_SECRETS_KEY_FILE=C:\secure\platform-secrets-key.txt
# Cloudflare Tunnel token (Zero Trust > Networks > Tunnels > your tunnel > install command):
TUNNEL_TOKEN_FILE=C:\secure\tunnel-token.txt
# The old hosted database host(s) this install must never connect to (comma separated):
LEGACY_DATABASE_HOSTS=aws-0-<region>.pooler.supabase.com
# Optional: other https origins whose dashboard calls this API (comma separated), e.g. the
# Cloudflare Pages site while it is still in use. HOSTNAME is always allowed.
EXTRA_CORS_ORIGINS=https://sanagtm.pages.dev
# Advanced: any ENV_<NAME>=<value> line is copied into sanagtm.env as <NAME>=<value>, e.g.
# ENV_GEMINI_API_KEY=...
