# Rendered at container start by the nginx image (envsubst of ${SANAGTM_*} only; nginx's own
# $variables are left alone because they are not defined in the environment).
# Reached only from cloudflared on the "edge" network; never published on the host.

map $http_upgrade $connection_upgrade { default upgrade; '' close; }

server {
    listen 8080;
    server_name _;
    root /usr/share/nginx/html;
    server_tokens off;
    client_max_body_size 260m;          # the app accepts uploads up to 250 MB

    set $sana_csp "default-src 'self'; script-src 'self'; style-src 'self'; img-src 'self' data:; font-src 'self'; connect-src 'self' ${SANAGTM_SUPABASE_URL} ${SANAGTM_SUPABASE_WSS}; frame-ancestors 'none'; base-uri 'self'; form-action 'self'; object-src 'none'";

    location = /healthz {
        access_log off;
        default_type text/plain;
        return 200 "ok\n";
    }

    # The API (its own security headers). The real client IP is Cloudflare's CF-Connecting-IP;
    # the API believes it only from this container (CAREERCLOUD_TRUSTED_PROXIES).
    location /api/ {
        proxy_pass http://api:8100;
        proxy_http_version 1.1;
        proxy_set_header Host $host;
        proxy_set_header CF-Connecting-IP $http_cf_connecting_ip;
        proxy_set_header X-Forwarded-For $proxy_add_x_forwarded_for;
        proxy_set_header X-Forwarded-Proto https;
        proxy_set_header Upgrade $http_upgrade;
        proxy_set_header Connection $connection_upgrade;
        proxy_request_buffering off;    # stream large CSV/XLSX uploads to the API
        proxy_buffering off;            # stream exports back
        proxy_read_timeout 600s;
        proxy_send_timeout 600s;
    }

    location /assets/ {
        include /etc/nginx/snippets/security-headers.conf;
        add_header Cache-Control "public, max-age=31536000, immutable" always;
        try_files $uri =404;
    }

    location / {
        include /etc/nginx/snippets/security-headers.conf;
        add_header Cache-Control "no-cache" always;
        try_files $uri /index.html;
    }
}
