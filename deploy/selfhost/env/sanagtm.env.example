# /etc/sanagtm/sanagtm.env — written by `sanagtm install` (root:root 0600). This example lists every
# variable the self-hosted install uses; values here are placeholders, never real secrets.

# --- written by the installer (do not change unless you know why) ------------------------------
CAREERCLOUD_ENV=production
CAREERCLOUD_SELF_HOSTED=1                  # local file storage + private-network DB allowed in production
CAREERCLOUD_STORAGE=postgres
CAREERCLOUD_QUEUE=postgres                 # PostgreSQL task queue; no Redis
CAREERCLOUD_DATABASE_URL=postgresql://sanagtm:<generated>@postgres:5432/sanagtm
CAREERCLOUD_DB_USER_ROLE=authenticated
CAREERCLOUD_DB_POOL_MAX=8
CAREERCLOUD_AUTH_MODE=supabase             # Supabase Auth (or a compatible GoTrue) issues the sign-in tokens
CAREERCLOUD_SUPABASE_URL=https://<ref>.supabase.co
CAREERCLOUD_API_ORIGIN=https://sanagtm.example.com
CAREERCLOUD_CORS_ORIGINS=https://sanagtm.example.com
CAREERCLOUD_TRUST_PROXY=cloudflare
CAREERCLOUD_LOG_FORMAT=json
CAREERCLOUD_LOG_LEVEL=info
CAREERCLOUD_STORAGE_BACKEND=local
CAREERCLOUD_PLATFORM_SECRETS_KEY=<44-character Fernet key: COPY the existing one when migrating>
CAREERCLOUD_RUNNER=none
SANAGTM_LEGACY_DATABASE_HOSTS=aws-0-<region>.pooler.supabase.com   # the old hosted DB this install must never use

# Set by compose.yaml (not in this file): CAREERCLOUD_PLATFORM_FILES_DIR, CAREERCLOUD_RESULTS_DIR,
# CAREERCLOUD_WORKER_STATE_FILE, CAREERCLOUD_RESOURCE_REGISTRY, CAREERCLOUD_TRUSTED_PROXIES, TMPDIR.

# --- optional integrations (add by hand, then: sudo sanagtm restart api worker) ------------------
# GEMINI_API_KEY=                          # AI, free-only mode is configured per workspace
# ANTHROPIC_API_KEY=
# OPENAI_COMPATIBLE_API_KEY= / OPENAI_COMPATIBLE_BASE_URL= / OPENAI_COMPATIBLE_MODEL=
# ZOOMINFO_CLIENT_ID= / ZOOMINFO_CLIENT_SECRET=   # else per-workspace credentials in Settings
# CAREERCLOUD_SMTP_HOST= / CAREERCLOUD_SMTP_PORT= / CAREERCLOUD_SMTP_USER= / CAREERCLOUD_SMTP_PASSWORD= / CAREERCLOUD_SMTP_FROM=
# CAREERCLOUD_PUBLIC_APP_URL=https://sanagtm.example.com
# CAREERCLOUD_ALLOW_EMAIL_SENDING=0        # outbound sequences stay off unless 1
# CAREERCLOUD_TASK_RETENTION_DAYS=90
# SANA_JOBSPY_BOARDS=                      # unofficial boards stay off unless listed (library not in the image)
