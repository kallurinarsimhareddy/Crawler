# CareerCrawler server configuration.
#
# Install to /etc/careercrawler/careercrawler.env and chmod 600 -- it names the
# spreadsheet and the credential file, so it is not world-readable.
#
# Every unit reads this file optionally (`EnvironmentFile=-`), so a missing file
# leaves the defaults compiled into the units in place. Values here override
# them without editing a single unit.

# --- what to crawl ---------------------------------------------------------
# The spreadsheet. The same value the Windows .env used; the crawler reads it
# from the environment either way.
CAREERCRAWLER_SPREADSHEET_ID=replace-me

# The service-account key. Must be readable by the service user and nobody else.
CAREERCRAWLER_GOOGLE_CREDENTIALS=/etc/careercrawler/service_account.json

# --- how hard to crawl -----------------------------------------------------
# Companies crawled at once. Six is what the roster has actually been run at;
# raising it needs the browser budget and the per-vendor limiter first, which
# are deliberately not part of this deployment.
CAREERCRAWLER_WORKERS=6

# Seconds between two requests to one host, across all workers.
CAREERCRAWLER_PER_HOST_DELAY=0.35

# --- where things go -------------------------------------------------------
# The full DEBUG log. Rotated by the crawler itself at 50 MB, eight kept.
CAREERCRAWLER_LOG=/opt/careercrawler/output/weekly.log

# The durable store. The run lock is derived from this path -- state/crawler.db
# is guarded by state/crawler.lock -- so pointing this elsewhere moves the lock
# with it. Must be local disk: SQLite locking is not safe over NFS or SMB.
CAREERCRAWLER_DATABASE=/opt/careercrawler/state/crawler.db
