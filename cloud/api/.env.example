# CareerCloud API — copy to cloud/api/.env (git-ignored) and start with
#   cloud/.venv/Scripts/python -m uvicorn cloud.api.main:app --reload --env-file cloud/api/.env
#
# No real credentials belong in this file. Production values come from the
# host's secret store, never from a committed file.

# development | test | staging | production
CAREERCLOUD_ENV=development

# Browser origins allowed to call the API, comma-separated. '*' is refused.
CAREERCLOUD_CORS_ORIGINS=http://localhost:5173,http://127.0.0.1:5173

# --- Storage -------------------------------------------------------------------
# memory: jobs vanish on restart (quick UI work).  postgres: the real thing.
CAREERCLOUD_STORAGE=postgres
# 'localdev' = the embedded PostgreSQL started by `python -m cloud.devtools.localpg start`.
# Anything else must be a postgresql:// URL. In development a non-local host is
# refused unless CAREERCLOUD_ALLOW_REMOTE_SERVICES=1.
CAREERCLOUD_DATABASE_URL=localdev
CAREERCLOUD_DB_USER_ROLE=authenticated
CAREERCLOUD_DB_POOL_MAX=10
# Where result files are kept (local object storage).
# CAREERCLOUD_RESULTS_DIR=cloud/.localdev/results

# --- Queue ---------------------------------------------------------------------
# inline: run jobs inside the API with the simulated runner (no worker, no Redis).
# redis:  enqueue for `python -m cloud.worker` (needs STORAGE=postgres).
CAREERCLOUD_QUEUE=redis
CAREERCLOUD_REDIS_URL=redis://127.0.0.1:6390/0
# CAREERCLOUD_QUEUE_PREFIX=careercloud:development
# Job types a worker executes; others are recorded as "not supported yet".
CAREERCLOUD_RUNNABLE_TYPES=single_company,bulk_companies
# inline only: fake | none, and the simulated step length.
CAREERCLOUD_RUNNER=fake
CAREERCLOUD_FAKE_STEP_SECONDS=1
CAREERCLOUD_MAX_CONCURRENT_JOBS=2

# --- Limits --------------------------------------------------------------------
CAREERCLOUD_MAX_ATTEMPTS=3
CAREERCLOUD_MAX_ACTIVE_JOBS_PER_USER=5

# --- Authentication ------------------------------------------------------------
# supabase: verify Supabase access tokens.  dev: local tokens, development only.
CAREERCLOUD_AUTH_MODE=dev
# dev mode: any random string of 32+ characters, e.g.
#   python -c "import secrets; print(secrets.token_urlsafe(48))"
CAREERCLOUD_DEV_JWT_SECRET=

# supabase mode: the project URL. Signing keys are fetched from its JWKS endpoint.
CAREERCLOUD_SUPABASE_URL=
# Only for projects still on the legacy shared HS256 JWT secret.
CAREERCLOUD_SUPABASE_JWT_SECRET=
CAREERCLOUD_SUPABASE_JWT_AUDIENCE=authenticated

# Never set these on the API. The anon key belongs to the browser; the
# service-role key bypasses row-level security and belongs nowhere near a
# request handler. Setting either logs a warning.
# CAREERCLOUD_SUPABASE_ANON_KEY=
# CAREERCLOUD_SUPABASE_SERVICE_ROLE_KEY=

# Development only: allow a hosted database/Redis (e.g. a Supabase dev project).
# CAREERCLOUD_ALLOW_REMOTE_SERVICES=1

# How long a worker may go without a heartbeat before /status and the dashboard
# call it offline. The worker beats every CAREERCLOUD_REAP_INTERVAL seconds
# (default 30), so this is three missed beats.
# CAREERCLOUD_WORKER_STALE_AFTER_SECONDS=90
