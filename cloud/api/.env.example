# CareerCloud API — copy to cloud/api/.env (git-ignored) and start with
#   uvicorn cloud.api.main:app --reload --env-file cloud/api/.env
#
# No real credentials belong in this file. Production values come from the
# host's secret store, never from a committed file.

# development | staging | production (reported by /api/v1/health)
CAREERCLOUD_ENV=development

# Browser origins allowed to call the API, comma-separated. '*' is refused.
CAREERCLOUD_CORS_ORIGINS=http://localhost:5173,http://127.0.0.1:5173

# fake: run jobs in-process with the simulated runner (no network, no disk).
# none: leave jobs queued for an external worker.
CAREERCLOUD_RUNNER=fake
CAREERCLOUD_FAKE_STEP_SECONDS=1
CAREERCLOUD_MAX_CONCURRENT_JOBS=2

# --- Phase 5B placeholders ---------------------------------------------------
# Read but NOT used yet: Phase 5A keeps jobs in memory and logs a warning if any
# of these is set. None of them may ever point at state/crawler.db or the
# production Google Sheet.
CAREERCLOUD_DATABASE_URL=
CAREERCLOUD_SUPABASE_URL=
CAREERCLOUD_SUPABASE_ANON_KEY=
CAREERCLOUD_SUPABASE_SERVICE_ROLE_KEY=
CAREERCLOUD_REDIS_URL=
