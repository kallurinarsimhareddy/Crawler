# CareerCloud dashboard — copy to cloud/web/.env.local (git-ignored) and fill in.
#
# Every VITE_* variable is compiled INTO the JavaScript bundle and readable by
# anyone who opens the site. Only public values belong here: never a database
# URL, a Redis URL, a JWT secret or a Supabase service-role key.

# Where the dashboard sends API requests. Leave empty in development: requests go
# to /api on the dev server and are proxied to VITE_DEV_API_PROXY.
# In a deployed build set it to the API origin, e.g. https://api.careercrawler.example
VITE_API_URL=

# Dev server only: where /api is forwarded.
VITE_DEV_API_PROXY=http://127.0.0.1:8000

# supabase: email/password sign-in through Supabase Auth.
# dev: sign in as any email against an API running CAREERCLOUD_AUTH_MODE=dev.
VITE_AUTH_MODE=dev

# supabase mode: the PUBLIC project URL and anon key. Row-level security and the
# API's token checks are what protect the data, not the secrecy of these.
VITE_SUPABASE_URL=
VITE_SUPABASE_ANON_KEY=
