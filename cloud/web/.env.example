# CareerCloud dashboard — copy to .env.local (git-ignored) and fill in.
#
# Every VITE_* variable is compiled INTO the JavaScript bundle and readable by
# anyone who opens the site. Only ever put public values here. Never a database
# URL, a Redis URL, or a Supabase service-role key.

# Where the dashboard sends API requests. Leave empty in development: requests go
# to /api on the dev server and are proxied to VITE_DEV_API_PROXY.
# In a deployed build set it to the API origin, e.g. https://api.careercrawler.example
VITE_API_URL=

# Dev server only: where /api is forwarded.
VITE_DEV_API_PROXY=http://127.0.0.1:8000

# --- Phase 5B placeholders (not read yet) ------------------------------------
# Supabase Auth runs in the browser, so these are the PUBLIC project URL and
# anon key. Row-level security in the database is what protects the data.
VITE_SUPABASE_URL=
VITE_SUPABASE_ANON_KEY=
