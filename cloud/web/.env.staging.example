# CareerCloud STAGING dashboard. Copy to cloud/web/.env.staging.local (git-ignored)
# and run `npm run build:staging`. Only PUBLIC staging values belong here.
VITE_DEPLOY_ENV=staging
VITE_AUTH_MODE=supabase
VITE_API_URL=https://api-staging.<your-domain>
VITE_SUPABASE_URL=https://<staging-project-ref>.supabase.co
VITE_SUPABASE_ANON_KEY=<staging-anon-or-publishable-key>
# Optional: verify the values against the same registry the API uses.
# VITE_RESOURCE_REGISTRY=../deploy/staging/env/resources.json
