# CareerCloud STAGING worker environment.
# Install as /etc/careercloud-staging/worker.env  owner root:ccstg-worker  mode 0640.
# Every <placeholder> must be a STAGING resource listed under "staging" in resources.json.

CAREERCLOUD_ENV=staging
CAREERCLOUD_RESOURCE_REGISTRY=/etc/careercloud-staging/resources.json
CAREERCLOUD_LOG_FORMAT=json
CAREERCLOUD_LOG_LEVEL=info

CAREERCLOUD_DATABASE_URL=postgresql://postgres.<staging-project-ref>:<staging-db-password>@aws-0-<region>.pooler.supabase.com:5432/postgres?sslmode=require
CAREERCLOUD_DB_POOL_MAX=4
CAREERCLOUD_REDIS_URL=rediss://default:<staging-redis-password>@<staging-redis>.upstash.io:6379
CAREERCLOUD_QUEUE_PREFIX=careercloud:staging

CAREERCLOUD_STORAGE_BACKEND=s3
CAREERCLOUD_S3_ENDPOINT=https://<staging-project-ref>.storage.supabase.co/storage/v1/s3
CAREERCLOUD_S3_REGION=<staging-project-region>
CAREERCLOUD_S3_BUCKET=careercloud-staging-results
CAREERCLOUD_S3_ACCESS_KEY_ID=<staging-s3-access-key-id>
CAREERCLOUD_S3_SECRET_ACCESS_KEY=<staging-s3-secret>
CAREERCLOUD_RESULTS_NAMESPACE=staging

# The real engine, through cloud/worker/careercrawler_runner.py.
CAREERCLOUD_WORKER_RUNNER=careercrawler
CAREERCLOUD_WORKER_CONCURRENCY=1
CAREERCLOUD_CRAWLER_COMPANY_CONCURRENCY=3
CAREERCLOUD_CRAWLER_MAX_RUNTIME_SECONDS=1800
# Browser rescue stays off: a browser bypasses the in-process egress guard.
CAREERCLOUD_CRAWLER_BROWSER_FALLBACK=false
CAREERCLOUD_EGRESS_GUARD=true
CAREERCLOUD_EGRESS_FIREWALL_CONFIRMED=true

CAREERCLOUD_WORKER_RUNTIME_DIR=/var/lib/careercloud-staging/runtime
CAREERCLOUD_LEASE_SECONDS=120
CAREERCLOUD_VISIBILITY_TIMEOUT=600
# Upstash free tier counts every command: a 10 s poll is ~260K reserve calls a month per worker.
CAREERCLOUD_POLL_INTERVAL=10
CAREERCLOUD_REAP_INTERVAL=30
CAREERCLOUD_ORPHAN_AFTER_SECONDS=600
CAREERCLOUD_MAX_ATTEMPTS=3
CAREERCLOUD_RETRY_BASE_DELAY=30
CAREERCLOUD_RETRY_MAX_DELAY=900
