# CareerCloud STAGING API environment.
# Install as /etc/careercloud-staging/api.env  owner root:ccstg-api  mode 0640.
# Every <placeholder> must be a STAGING resource listed under "staging" in resources.json.
# Never paste a production value here: the API refuses to start if you do.

CAREERCLOUD_ENV=staging
CAREERCLOUD_RESOURCE_REGISTRY=/etc/careercloud-staging/resources.json
CAREERCLOUD_LOG_FORMAT=json
CAREERCLOUD_LOG_LEVEL=info

# Public origins
CAREERCLOUD_API_ORIGIN=https://api-staging.<your-domain>
CAREERCLOUD_CORS_ORIGINS=https://careercloud-staging.pages.dev
CAREERCLOUD_TRUST_PROXY=cloudflare

# Database: Supabase STAGING project, session pooler (port 5432), TLS required.
CAREERCLOUD_STORAGE=postgres
CAREERCLOUD_DATABASE_URL=postgresql://postgres.<staging-project-ref>:<staging-db-password>@aws-0-<region>.pooler.supabase.com:5432/postgres?sslmode=require
CAREERCLOUD_DB_USER_ROLE=authenticated
CAREERCLOUD_DB_POOL_MAX=5

# Queue: STAGING Redis, TLS + password, staging prefix.
CAREERCLOUD_QUEUE=redis
CAREERCLOUD_REDIS_URL=rediss://default:<staging-redis-password>@<staging-redis>.upstash.io:6379
CAREERCLOUD_QUEUE_PREFIX=careercloud:staging
CAREERCLOUD_RUNNABLE_TYPES=single_company,bulk_companies

# Auth: Supabase STAGING project. Keys come from its JWKS endpoint; no secret needed
# unless the project still uses the legacy HS256 JWT secret.
CAREERCLOUD_AUTH_MODE=supabase
CAREERCLOUD_SUPABASE_URL=https://<staging-project-ref>.supabase.co
# CAREERCLOUD_SUPABASE_JWT_SECRET=

# Results: private STAGING bucket over the S3 protocol (S3 access keys, not the service-role key).
CAREERCLOUD_STORAGE_BACKEND=s3
CAREERCLOUD_S3_ENDPOINT=https://<staging-project-ref>.storage.supabase.co/storage/v1/s3
CAREERCLOUD_S3_REGION=<staging-project-region>
CAREERCLOUD_S3_BUCKET=careercloud-staging-results
CAREERCLOUD_S3_ACCESS_KEY_ID=<staging-s3-access-key-id>
CAREERCLOUD_S3_SECRET_ACCESS_KEY=<staging-s3-secret>
CAREERCLOUD_RESULTS_NAMESPACE=staging

# Limits
CAREERCLOUD_MAX_ATTEMPTS=3
CAREERCLOUD_MAX_ACTIVE_JOBS_PER_USER=3
CAREERCLOUD_RATE_LIMIT_PER_MINUTE=120
CAREERCLOUD_JOB_CREATE_PER_HOUR=20
