# CareerCloud worker — copy to cloud/worker/.env (git-ignored) and start with
#   cloud/.venv/Scripts/python -m cloud.worker --env-file cloud/worker/.env
# from the repository root.
#
# The worker reads CAREERCLOUD_* variables only. It never reads the crawler's
# .env, secrets/, state/ or output/, and refuses a runtime directory inside them.
# No real credentials belong in this file.

CAREERCLOUD_ENV=development

# Same database and queue as the API.
CAREERCLOUD_DATABASE_URL=localdev
CAREERCLOUD_REDIS_URL=redis://127.0.0.1:6390/0
# CAREERCLOUD_QUEUE_PREFIX=careercloud:development
CAREERCLOUD_DB_POOL_MAX=5
# CAREERCLOUD_ALLOW_REMOTE_SERVICES=1

# careercrawler: the real engine.  fake: simulated runs, no network.
CAREERCLOUD_WORKER_RUNNER=careercrawler
CAREERCLOUD_WORKER_CONCURRENCY=1

# Leases, heartbeats and recovery. Heartbeats run every lease/3.
CAREERCLOUD_LEASE_SECONDS=120
CAREERCLOUD_VISIBILITY_TIMEOUT=600
CAREERCLOUD_POLL_INTERVAL=2
CAREERCLOUD_REAP_INTERVAL=30
CAREERCLOUD_ORPHAN_AFTER_SECONDS=600

# Bounded retries: attempts include the first run; the delay doubles and is capped.
CAREERCLOUD_MAX_ATTEMPTS=3
CAREERCLOUD_RETRY_BASE_DELAY=30
CAREERCLOUD_RETRY_MAX_DELAY=900

# Scratch space per job attempt (default cloud/runtime) and result files
# (default cloud/.localdev/results). Both must be outside the crawler's
# state/, output/, input/ and secrets/.
# CAREERCLOUD_WORKER_RUNTIME_DIR=
# CAREERCLOUD_RESULTS_DIR=
CAREERCLOUD_KEEP_WORKSPACES=false

# Crawler knobs for CLOUD jobs only. The production weekly run keeps its own
# defaults (including its worker count); nothing here changes them.
CAREERCLOUD_CRAWLER_COMPANY_CONCURRENCY=4
CAREERCLOUD_CRAWLER_BROWSER_FALLBACK=false
CAREERCLOUD_CRAWLER_MAX_RUNTIME_SECONDS=3600

# fake runner only
CAREERCLOUD_FAKE_STEP_SECONDS=1
