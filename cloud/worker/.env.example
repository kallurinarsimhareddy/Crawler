# CareerCloud worker — Phase 5B placeholders. Nothing reads this file yet.
#
# The worker will consume job ids from Redis, run them through the existing
# CareerCrawler engine, and write status back to PostgreSQL/Supabase.
# No real credentials belong in this file.

CAREERCLOUD_ENV=development

# Queue and job store (shared with the API).
CAREERCLOUD_REDIS_URL=
CAREERCLOUD_DATABASE_URL=
CAREERCLOUD_SUPABASE_URL=
CAREERCLOUD_SUPABASE_SERVICE_ROLE_KEY=

# Which runner executes jobs: fake until the CareerCrawler runner exists.
CAREERCLOUD_WORKER_RUNNER=fake

# Jobs this worker process runs at once.
CAREERCLOUD_WORKER_CONCURRENCY=1

# Crawler knobs passed to the engine per job. These are the CLOUD worker's own
# values and are independent of the production weekly run, whose default stays
# at 6 workers. Leave empty to use the engine's defaults.
CAREERCLOUD_CRAWLER_WORKERS=
CAREERCLOUD_CRAWLER_BROWSER_BUDGET=
CAREERCLOUD_CRAWLER_HOST_CONCURRENCY=

# Where per-job result files go before upload. Must NOT be the crawler's
# output/ or state/ directory.
CAREERCLOUD_WORKER_SCRATCH_DIR=
